# ====== PostgreSQL (DB konteyneri) ======
POSTGRES_DB=employee_checking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123

# ====== Spring Boot (App konteyneri) ======
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/employee_checking
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=123

# ====== Application Settings ======
APP_JWT_SECRET=please_replace_with_a_really_long_random_256bit_secret

# ====== Optional: Timezone va JVM ======
TZ=Asia/Tashkent
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC

# Server sozlamalari
SERVER_PORT=8080

# Spring Application
SPRING_APPLICATION_NAME="Employee Checking Platform"

# JPA va Hibernate
SPRING_JPA_OPEN_IN_VIEW=true
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
HIBERNATE_DEFAULT_BATCH_FETCH_SIZE=50

# Logging darajalari
LOG_ROOT_LEVEL=INFO
LOG_WEB_LEVEL=INFO
LOG_HIBERNATE_SQL_LEVEL=WARN
LOG_HIBERNATE_BIND_LEVEL=WARN

# JWT Sozlamalari
# DIQQAT: Kamida 32 ta belgidan iborat maxfiy kalit yozing!
APP_JWT_SECRET=change_this_to_a_256bit_random_secret_at_least_32_chars_long
APP_JWT_ACCESS_EXP_MIN=300

# Admin foydalanuvchi (Seed qilish uchun)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin
APP_ADMIN_NAME="Super Admin"

# Tashkilot sozlamalari
APP_TASHKILOT_NAME="Mudofaa vazirligi"

# Face ID API (Token olish uchun)
FACE_TOKEN_URL=http://192.168.202.27:8002/api/v1/auth/oauth2/token
FACE_UPLOAD_URL1=http://192.168.202.27:8002
FACE_BASIC_USERNAME=test
FACE_BASIC_PASSWORD=Aa990173541
FACE_RO_USERNAME=test
FACE_RO_PASSWORD=Aa990173541

# Face ID API (Rasm yuklash va tanib olish uchun)
FACE_UPLOAD_URL=http://192.168.202.27:8002/api/v1/faceid/recognize
FACE_UPLOAD_PARAM=image
FACE_UPLOAD_AS_FORM=true
FACE_UPLOAD_DATA_URI=false
FACE_UPLOAD_INCLUDE_FILENAME=true
FACE_UPLOAD_INCLUDE_CONTENT_TYPE=true
FACE_UPLOAD_DEFAULT_IS_PHOTO=Y