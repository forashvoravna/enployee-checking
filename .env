# ====== PostgreSQL (DB konteyneri) ======
POSTGRES_DB=employee_checking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123

# ====== Spring Boot (App konteyneri) ======
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/employee_checking
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=123

# ====== Application Settings ======
APP_JWT_SECRET=please_replace_with_a_really_long_random_256bit_secret

# ====== Optional: Timezone va JVM ======
TZ=Asia/Tashkent
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC

